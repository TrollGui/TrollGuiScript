-- ===== Minigame de ouro =====
local goldMinigameActive = false
local goldDebt = 150
local goldTimeLeft = 40
local goldConnection

local function stopGoldMinigame()
	goldMinigameActive = false
	goldFrame.Visible = false
	goldGui.Enabled = false
	
	-- Remove SpeedBoost ao terminar
	local character = Player.Character
	if character then
		character:SetAttribute("SpeedBoost", 0.1)
	end
	
	if goldConnection then
		goldConnection:Disconnect()
		goldConnection = nil
	end
end

local function startGoldMinigame()
	goldMinigameActive = true
	goldDebt = 150
	goldTimeLeft = 40

	-- Ativa SpeedBoost ao iniciar
	local character = Player.Character
	if character then
		character:SetAttribute("SpeedBoost", 5)
	end

	goldGui.Enabled = true
	goldFrame.Visible = true
	goldTop.Visible = true
	goldText.Text = tostring(goldDebt)
	goldTimer.Text = string.format("%.1f", goldTimeLeft)

	local topbarUI = PlayerGui:FindFirstChild("TopbarUI")
	local topbar = topbarUI and topbarUI:FindFirstChild("Topbar")
	local goldLabel = topbar and topbar:FindFirstChild("Gold")

	local lastGoldValue = nil
	if goldLabel and goldLabel:IsA("TextLabel") then
		lastGoldValue = tonumber(goldLabel.Text) or 0
	end

	if goldLabel and goldLabel:IsA("TextLabel") then
		goldConnection = goldLabel:GetPropertyChangedSignal("Text"):Connect(function()
			if not goldMinigameActive then return end
			local newValue = tonumber(goldLabel.Text)
			if not newValue or not lastGoldValue then return end
			local diff = newValue - lastGoldValue
			lastGoldValue = newValue
			if diff > 0 then
				-- Quanto maior o valor, maior a redução da dívida
				-- Ex: 40+ -> 80, 20+ -> 40, 10+ -> 25, 5+ -> 5
				local reduction = diff
				if diff >= 40 then
					reduction = 80
				elseif diff >= 20 then
					reduction = 40
				elseif diff >= 10 then
					reduction = 25
				elseif diff >= 5 then
					reduction = 5
				end
				goldDebt = math.max(0, goldDebt - reduction)
				goldText.Text = tostring(goldDebt)
				if goldDebt <= 0 then
					stopGoldMinigame()
					return
				end
			end
		end)
	end

	task.spawn(function()
		while goldMinigameActive and goldTimeLeft > 0 do
			task.wait(0.1)
			goldTimeLeft = goldTimeLeft - 0.1
			goldTimer.Text = string.format("%.1f", math.max(0, goldTimeLeft))
		end
		if goldMinigameActive then
			stopGoldMinigame()
			damagePlayer()
		end
	end)
end


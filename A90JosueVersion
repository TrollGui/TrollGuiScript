-- ===== Static =====
local staticPart
local staticCarmine
local staticBlack
local staticConnection
local staticActive = false
local staticAttack = false

local function createStaticPart()
	if staticPart then staticPart:Destroy() end
	local camera = workspace.CurrentCamera
	if not camera then return end

	staticPart = Instance.new("Part")
	staticPart.Name = "A90Static"
	staticPart.Anchored = true
	staticPart.CanCollide = false
	staticPart.CanTouch = false
	staticPart.CanQuery = false
	staticPart.CastShadow = false
	staticPart.Material = Enum.Material.SmoothPlastic
	staticPart.Transparency = 1
	staticPart.Size = Vector3.new(20, 20, 0.05)
	staticPart.Parent = workspace

	staticCarmine = Instance.new("Texture")
	staticCarmine.Name = "OrangeStatic"
	staticCarmine.Texture = STATIC_TEXTURE
	staticCarmine.Face = Enum.NormalId.Front
	staticCarmine.Color3 = ORANGE
	staticCarmine.Transparency = 0
	staticCarmine.StudsPerTileU = 0.35
	staticCarmine.StudsPerTileV = 0.35
	staticCarmine.OffsetStudsU = math.random()
	staticCarmine.OffsetStudsV = math.random()
	staticCarmine.Parent = staticPart

	staticBlack = Instance.new("Texture")
	staticBlack.Name = "BlackStatic"
	staticBlack.Texture = STATIC_TEXTURE
	staticBlack.Face = Enum.NormalId.Front
	staticBlack.Color3 = BLACK
	staticBlack.Transparency = 0.35
	staticBlack.StudsPerTileU = 0.35
	staticBlack.StudsPerTileV = 0.35
	staticBlack.OffsetStudsU = math.random()
	staticBlack.OffsetStudsV = math.random()
	staticBlack.Parent = staticPart

	staticActive = true
	staticAttack = false

	if staticConnection then staticConnection:Disconnect() end

	staticConnection = RunService.RenderStepped:Connect(function()
		if not staticActive or not staticPart or not staticPart.Parent then return end
		camera = workspace.CurrentCamera
		if not camera then return end

		local distance = 0.7
		local viewport = camera.ViewportSize
		local aspect = viewport.X / math.max(viewport.Y, 1)
		local verticalSize = 2 * distance * math.tan(math.rad(camera.FieldOfView * 0.5))
		local horizontalSize = verticalSize * aspect

		staticPart.Size = Vector3.new(horizontalSize, verticalSize, 0.05)
		local cameraPosition = camera.CFrame.Position
		local targetPosition = cameraPosition + camera.CFrame.LookVector * distance
		staticPart.CFrame = CFrame.lookAt(targetPosition, cameraPosition)

		staticCarmine.OffsetStudsU = math.random() * 2
		staticCarmine.OffsetStudsV = math.random() * 2
		staticBlack.OffsetStudsU = math.random() * 2
		staticBlack.OffsetStudsV = math.random() * 2

		if staticAttack then
			staticCarmine.Color3 = RED
			staticBlack.Color3 = RED
			staticCarmine.Transparency = math.random(0, 10) / 100
			staticBlack.Transparency = math.random(10, 50) / 100
			if math.random() < 0.18 then
				staticCarmine.StudsPerTileU = math.random(25, 45) / 100
				staticCarmine.StudsPerTileV = math.random(25, 45) / 100
			end
			if math.random() < 0.18 then
				staticBlack.StudsPerTileU = math.random(25, 45) / 100
				staticBlack.StudsPerTileV = math.random(25, 45) / 100
			end
		else
			staticCarmine.Color3 = ORANGE
			staticBlack.Color3 = BLACK
			staticCarmine.Transparency = 0
			staticBlack.Transparency = 0.35
		end
	end)
end

local function destroyStatic()
	staticActive = false
	if staticConnection then
		staticConnection:Disconnect()
		staticConnection = nil
	end
	if staticPart then
		staticPart:Destroy()
		staticPart = nil
	end
	staticCarmine = nil
	staticBlack = nil
end

local function playSound(id, volume)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 1
	sound.Looped = false
	sound.Parent = SoundService

	local loadedConn
	loadedConn = sound.Loaded:Connect(function()
		sound:Play()
		if loadedConn then loadedConn:Disconnect() end
	end)

	task.spawn(function()
		task.wait(0.1)
		if sound and sound.Parent and not sound.IsPlaying then
			sound:Play()
		end
	end)

	task.delay(8, function()
		if sound then sound:Destroy() end
	end)

	return sound
end

local function playerIsMoving()
	local character = Player.Character
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
		return true
	end
	return false
end

local function damagePlayer()
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:TakeDamage(DAMAGE)
		end)
	end
	local remote = ReplicatedStorage:FindFirstChild("A90Remote", true)
	if remote and remote:IsA("RemoteEvent") then
		pcall(function()
			remote:FireServer("Damage", DAMAGE)
		end)
	end
end

local function getPlayerHealth()
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.Health or 100
end


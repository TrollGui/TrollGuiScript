-- ===== SISTEMA DE ANDAR =====
local function getMovementDirection()
	local character = Player.Character
	if not character then return nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude < 0.05 then return nil end

	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local camCF = camera.CFrame
	local right = camCF.RightVector
	local forward = camCF.LookVector

	local flatMove = Vector3.new(moveDir.X, 0, moveDir.Z)
	local flatRight = Vector3.new(right.X, 0, right.Z)
	local flatForward = Vector3.new(forward.X, 0, forward.Z)

	if flatMove.Magnitude < 0.01 then
		if moveDir.Y > 0.05 then
			return "Up"
		end
		return nil
	end

	flatMove = flatMove.Unit
	flatRight = flatRight.Unit
	flatForward = flatForward.Unit

	local dotRight = flatMove:Dot(flatRight)
	local dotForward = flatMove:Dot(flatForward)

	if math.abs(dotRight) > math.abs(dotForward) then
		return dotRight > 0 and "Right" or "Left"
	else
		return dotForward > 0 and "Up" or "Down"
	end
end

local function isMovementAllowed(allowedDir)
	local dir = getMovementDirection()
	if not dir then return true end
	return dir == allowedDir
end

-- ===== Fase 1 do attack =====
local function attackPhase1()
	staticAttack = true
	if staticCarmine then staticCarmine.Color3 = RED end
	if staticBlack then staticBlack.Color3 = RED end

	playSound(SOUND_ATTACK, 1.5)

	faceContainer.Visible = true
	face.Image = IMG_GLITCH
	face.ImageColor3 = WHITE
	hair.Visible = true

	task.wait(0.4)
	faceContainer.Visible = false
	task.wait(0.2)

	jumpscare.Visible = true
	jumpscareHair.Visible = true

	local shakeStart = os.clock()
	while os.clock() - shakeStart < 1 do
		jumpscare.Position = UDim2.fromScale(
			0.5 + math.random(-12, 12) / 1000,
			0.5 + math.random(-12, 12) / 1000
		)
		jumpscare.Rotation = math.random(-3, 3)
		task.wait(0.025)
	end

	jumpscare.Position = UDim2.fromScale(0.5, 0.5)
	jumpscare.Rotation = 0
	jumpscare.Visible = false
	jumpscareHair.Visible = false

	destroyStatic()

	if getPlayerHealth() <= 20 then
		showLowHPSequence()
	end

	damagePlayer()

	local attackCount = Player:GetAttribute("A90AttackCount") or 0
	attackCount = attackCount + 1
	Player:SetAttribute("A90AttackCount", attackCount)

	if attackCount >= 2 then
		startGoldMinigame()
		-- Espera o minigame terminar para voltar ao ciclo
		while goldMinigameActive do
			task.wait(0.1)
		end
		-- Reseta o contador para voltar ao ciclo (fase 1 -> ouro -> fase 1...)
		Player:SetAttribute("A90AttackCount", 0)
		return
	end

	-- Fase 1: imagem lateral
	local currentPosIndex = math.random(1, #SIDE_POSITIONS)
	sideImage.Visible = true
	sideHair.Visible = true

	local posData = SIDE_POSITIONS[currentPosIndex]
	sideImage.Position = posData.pos
	sideImage.AnchorPoint = posData.anchor

	local phase1Active = true
	local phaseStartTime = os.clock()
	local imageHidden = false
	local lastPosChange = os.clock()

	while phase1Active do
		local now = os.clock()
		local elapsed = now - phaseStartTime

		if not imageHidden then
			if playerIsMoving() then
				local allowedDir = SIDE_POSITIONS[currentPosIndex].dir
				if not isMovementAllowed(allowedDir) then
					phase1Active = false
					sideImage.Visible = false
					sideHair.Visible = false
					damagePlayer()
					return
				end
			end
		else
			if playerIsMoving() then
				phase1Active = false
				sideImage.Visible = false
				sideHair.Visible = false
				damagePlayer()
				return
			end
		end

		if now - lastPosChange >= 10 and not imageHidden then
			lastPosChange = now
			currentPosIndex = currentPosIndex % #SIDE_POSITIONS + 1
			moveSideImageTo(currentPosIndex)
		end

		if elapsed >= 40 and not imageHidden then
			imageHidden = true
			sideImage.Visible = false
			sideHair.Visible = false
		end

		if elapsed >= 70 then
			phase1Active = false
			break
		end

		task.wait(0.03)
	end

	sideImage.Visible = false
	sideHair.Visible = false
	destroyStatic()
end

-- ===== Ataque =====
local function attack()
	attackPhase1()

	background.Visible = true
	background.BackgroundColor3 = WHITE
	background.BackgroundTransparency = 0

	task.wait(0.2)
	background.BackgroundColor3 = RED

	task.wait(0.2)

	local fade = TweenService:Create(background, TweenInfo.new(0.7, Enum.EasingStyle.Linear), {
		BackgroundTransparency = 1
	})
	fade:Play()
	fade.Completed:Wait()

	background.Visible = false
	playSound(SOUND_DEATH, 1.5)

	vignette.Visible = true
	vignette.BackgroundTransparency = 0.15

	local vignetteFade = TweenService:Create(vignette, TweenInfo.new(15, Enum.EasingStyle.Linear), {
		BackgroundTransparency = 1
	})
	vignetteFade:Play()
	vignetteFade.Completed:Wait()

	vignette.Visible = false

	local remote = ReplicatedStorage:FindFirstChild("A90Remote", true)
	if remote and remote:IsA("RemoteEvent") then
		pcall(function()
			remote:FireServer("Died", "A-90")
		end)
	end
end

-- ===== Spawn (6 segundos) COM DETECÇÃO DURANTE TODO O SPAWN =====
local function runSpawn()
	gui.Enabled = true

	faceContainer.Visible = false
	jumpscare.Visible = false
	jumpscareHair.Visible = false
	background.Visible = false
	vignette.Visible = false

	face.ImageTransparency = 0
	hair.Visible = false

	createStaticPart()
	playSound(SOUND_APPEAR, 10)

	if SOUND_APPEAR_LEAD_TIME > 0 then
		task.wait(SOUND_APPEAR_LEAD_TIME)
	end

	-- ===== DETECÇÃO DURANTE TODO O SPAWN =====
	local movedDuringSpawn = false
	local spawnStartPosition = nil
	do
		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		spawnStartPosition = root and root.Position
	end

	local spawnInputConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if movedDuringSpawn then return end

		if input.UserInputType == Enum.UserInputType.Keyboard then
			local key = input.KeyCode
			if key == Enum.KeyCode.W or key == Enum.KeyCode.A or key == Enum.KeyCode.S or key == Enum.KeyCode.D
				or key == Enum.KeyCode.Space or key == Enum.KeyCode.Up or key == Enum.KeyCode.Down
				or key == Enum.KeyCode.Left or key == Enum.KeyCode.Right then
				movedDuringSpawn = true
			end
		elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
			movedDuringSpawn = true
		elseif input.UserInputType == Enum.UserInputType.Touch then
			movedDuringSpawn = true
		end
	end)

	local spawnCheckConn
	spawnCheckConn = RunService.Heartbeat:Connect(function()
		if movedDuringSpawn then return end
		if playerIsMoving() then
			movedDuringSpawn = true
			return
		end
		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and spawnStartPosition then
			if (root.Position - spawnStartPosition).Magnitude > 0.08 then
				movedDuringSpawn = true
			end
		end
	end)

	-- Fase de spawn visual
	local spawnStart = os.clock()
	local spawnDuration = 6

	faceContainer.Visible = true
	face.Image = IMG_NORMAL
	face.ImageColor3 = WHITE
	faceContainer.Size = UDim2.fromOffset(240, 240)
	faceContainer.Position = UDim2.fromScale(
		math.random(15, 85) / 100,
		math.random(15, 85) / 100
	)

	-- 1s: começa a tremer
	task.wait(1)

	local shakeStart = os.clock()
	while os.clock() - shakeStart < 1 do
		faceContainer.Position = UDim2.fromScale(
			0.5 + math.random(-10, 10) / 500,
			0.5 + math.random(-10, 10) / 500
		)
		task.wait(0.03)
	end
	faceContainer.Position = UDim2.fromScale(0.5, 0.5)

	-- 2s: muda para IMG_SPAWN_ALT
	face.Image = IMG_SPAWN_ALT
	hair.Visible = true

	-- 0.3s depois: volta para IMG_NORMAL
	task.wait(0.3)
	face.Image = IMG_NORMAL

	-- 4s: imagem pequena sobe do fundo (meio e um pouco no canto inferior direito)
	local elapsed = os.clock() - spawnStart
	local waitTime = 4 - elapsed
	if waitTime > 0 then task.wait(waitTime) end

	lowImage.Visible = true
	lowHair.Visible = true
	-- Posição inicial: abaixo da tela, no meio e um pouco para a direita
	lowImage.Position = UDim2.new(0.65, 0, 1.2, 0)
	lowImage.AnchorPoint = Vector2.new(0.5, 0.5)

	local riseTween = TweenService:Create(lowImage, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.65, 0, 0.75, 0)  -- Sobe para o meio e um pouco no canto inferior direito
	})
	riseTween:Play()
	riseTween.Completed:Wait()

	-- 5s: desce
	task.wait(0.5)
	local fallTween = TweenService:Create(lowImage, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(0.65, 0, 1.2, 0)
	})
	fallTween:Play()
	fallTween.Completed:Wait()

	lowImage.Visible = false
	lowHair.Visible = false

	-- Aguarda o resto dos 6s
	elapsed = os.clock() - spawnStart
	waitTime = 6 - elapsed
	if waitTime > 0 then task.wait(waitTime) end

	-- Desconecta detecção de spawn
	spawnInputConn:Disconnect()
	spawnCheckConn:Disconnect()

	-- Se moveu durante o spawn -> ataca
	if movedDuringSpawn then
		attack()
		return
	end

	-- Janela final de detecção (1.1s) após o spawn
	local finalMoved = false
	local detectionStart = os.clock()

	local finalInputConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local key = input.KeyCode
			if key == Enum.KeyCode.W or key == Enum.KeyCode.A or key == Enum.KeyCode.S or key == Enum.KeyCode.D
				or key == Enum.KeyCode.Space or key == Enum.KeyCode.Up or key == Enum.KeyCode.Down
				or key == Enum.KeyCode.Left or key == Enum.KeyCode.Right then
				finalMoved = true
			end
		elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
			finalMoved = true
		elseif input.UserInputType == Enum.UserInputType.Touch then
			finalMoved = true
		end
	end)

	while os.clock() - detectionStart < DETECTION_WINDOW do
		if not finalMoved and playerIsMoving() then
			finalMoved = true
		end
		task.wait()
	end

	finalInputConn:Disconnect()

	if finalMoved then
		attack()
		return
	end

	-- Fade do rosto
	local fadeFace = TweenService:Create(faceContainer, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {
		Size = UDim2.fromOffset(0, 0)
	})
	fadeFace:Play()
	fadeFace.Completed:Wait()

	faceContainer.Size = UDim2.fromOffset(240, 240)
	faceContainer.Visible = false
	hair.Visible = false

	destroyStatic()
end

-- ===== Loop principal =====
task.spawn(function()
	task.wait(INITIAL_DELAY)

	-- Sempre repete, independente de ENABLE_RESPAWN
	while true do
		pcall(runSpawn)
		task.wait(math.random(MIN_INTERVAL, MAX_INTERVAL))
	end
end)

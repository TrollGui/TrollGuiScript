-- Anti Cheat
local player = game.Players.LocalPlayer
local serverScripts = player.PlayerScripts:FindFirstChild("Server")

if serverScripts then
    local keepScripts = {"Beams", "Device", "HD logger", "Icons", "KnitSystem"}
    
    local function isRandomName(name)
        if #name < 5 or #name > 15 then
            return false
        end
        
        local hasUpper = false
        local hasLower = false
        
        for i = 1, #name do
            local char = string.sub(name, i, i)
            if char == string.upper(char) and char ~= string.lower(char) then
                hasUpper = true
            elseif char == string.lower(char) and char ~= string.upper(char) then
                hasLower = true
            end
        end
        
        return hasUpper and hasLower
    end
    
    for _, child in ipairs(serverScripts:GetChildren()) do
        if child:IsA("Script") or child:IsA("LocalScript") then
            local source = child.Source or ""
            if string.find(source, "getRandomString") or string.find(source, "Random%.new%(") then
                print("Deletando script gerador: " .. child.Name)
                child:Destroy()
            end
        end
    end
    
    for _, child in ipairs(serverScripts:GetChildren()) do
        local shouldKeep = false
        
        for _, keepName in ipairs(keepScripts) do
            if child.Name == keepName then
                shouldKeep = true
                break
            end
        end
        
        if not shouldKeep and isRandomName(child.Name) then
            print("Deletando script com nome aleatório: " .. child.Name)
            child:Destroy()
        end
    end
end

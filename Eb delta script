local PathFinding = {
    Nome = "PathFinding",
    IsToggle = true,
    Repeat = false,

    Script = (function()

        local TARGET_POSITION = Vector3.new(20.71, 3.04, -974.72)
        local isRunning = false
        local stopPathfinding = false
        local currentCoroutine = nil

        local function walkToTarget()
            local player = Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local humanoid = character:WaitForChild("Humanoid")
            local rootPart = character:WaitForChild("HumanoidRootPart")

            if not rootPart or not humanoid then return end

            local path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 3,
            })

            local success, errorMessage = pcall(function()
                path:ComputeAsync(rootPart.Position, TARGET_POSITION)
            end)

            if not success then
                                return
            end

            if path.Status ~= Enum.PathStatus.Success then
                                return
            end

            local waypoints = path:GetWaypoints()

            for i, waypoint in ipairs(waypoints) do
                if stopPathfinding or not pathfindingActive then
                    humanoid:MoveTo(rootPart.Position)
                    return
                end

                if path.Status ~= Enum.PathStatus.Success then
                    break
                end

                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                humanoid:MoveTo(waypoint.Position)

                local reached = humanoid.MoveToFinished:Wait()

                if not reached then
                    if pathfindingActive and not stopPathfinding then
                        walkToTarget()
                    end
                    return
                end
            end

            if pathfindingActive and not stopPathfinding then
                            end
        end

        local function startPathfinding()
            if currentCoroutine then
                coroutine.close(currentCoroutine)
                currentCoroutine = nil
            end

            stopPathfinding = false

            currentCoroutine = coroutine.create(function()
                while pathfindingActive and not stopPathfinding do
                    local player = Players.LocalPlayer
                    local character = player.Character or player.CharacterAdded:Wait()
                    local rootPart = character:WaitForChild("HumanoidRootPart")

                    if not rootPart then break end

                    local path = PathfindingService:CreatePath({
                        AgentRadius = 2,
                        AgentHeight = 5,
                        AgentCanJump = true,
                        AgentCanClimb = true,
                        WaypointSpacing = 3,
                    })

                    local success = pcall(function()
                        path:ComputeAsync(rootPart.Position, TARGET_POSITION)
                    end)

                    if not success or path.Status ~= Enum.PathStatus.Success then
                        walkToTarget()
                    else
                        local connection
                        connection = path.Blocked:Connect(function(blockedWaypointIndex)
                            connection:Disconnect()
                            if pathfindingActive and not stopPathfinding then
                                walkToTarget()
                            end
                        end)

                        walkToTarget()

                        if connection then
                            connection:Disconnect()
                        end
                    end

                    task.wait(0.5)
                end
            end)

            coroutine.resume(currentCoroutine)
        end

        return function(state)
            pathfindingActive = state

            if state then
                stopPathfinding = false
                startPathfinding()
            else
                stopPathfinding = true
                pathfindingActive = false

                if currentCoroutine then
                    coroutine.close(currentCoroutine)
                    currentCoroutine = nil
                end

                local player = Players.LocalPlayer
                local character = player.Character
                if character then
                    local humanoid = character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:MoveTo(Vector3.new(0, 0, 0))
                    end
                end

                            end
        end

    end)()
}


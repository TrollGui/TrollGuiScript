local Underground = {
    Nome = "Underground",
    IsToggle = true,
    Repeat = false,

    Script = (function()

        local SavedData = {}

        return function(state)

            local animationTime = 0.5

            local Players = game:GetService("Players")
            local TweenService = game:GetService("TweenService")

            local player = Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()

            local humanoid = character:WaitForChild("Humanoid")
            local root = character:WaitForChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera

            if state then

                SavedData = {

                    CFrame = root.CFrame,

                    WalkSpeed = humanoid.WalkSpeed,
                    JumpPower = humanoid.JumpPower,
                    UseJumpPower = humanoid.UseJumpPower,
                    AutoRotate = humanoid.AutoRotate,
                    PlatformStand = humanoid.PlatformStand,

                    CameraSubject = camera.CameraSubject,
                    CameraType = camera.CameraType,

                    Velocity = root.AssemblyLinearVelocity,
                    AngularVelocity = root.AssemblyAngularVelocity,

                    Anchored = root.Anchored,

                    State = humanoid:GetState()

                }

                local cameraPart = workspace:FindFirstChild("UndergroundCameraPoint")

                if not cameraPart then

                    cameraPart = Instance.new("Part")
                    cameraPart.Name = "UndergroundCameraPoint"
                    cameraPart.Size = Vector3.new(.1,.1,.1)
                    cameraPart.Transparency = 1
                    cameraPart.CanCollide = false
                    cameraPart.Anchored = true
                    cameraPart.Parent = workspace

                end

                cameraPart.CFrame = root.CFrame + Vector3.new(0,1.5,0)

                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = cameraPart

                humanoid.AutoRotate = false
                humanoid.PlatformStand = true

                root.Anchored = false

                local tween = TweenService:Create(
                    root,
                    TweenInfo.new(animationTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {
                        CFrame = root.CFrame * CFrame.new(0,-15,0)
                    }
                )

                tween:Play()

                tween.Completed:Connect(function()

                    if state then
                        root.Anchored = true
                    end

                end)

            else

                if not SavedData.CFrame then
                    return
                end

                local cameraPart = workspace:FindFirstChild("UndergroundCameraPoint")

                root.Anchored = false

                local tween = TweenService:Create(
                    root,
                    TweenInfo.new(animationTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {
                        CFrame = SavedData.CFrame
                    }
                )

                tween:Play()

                tween.Completed:Connect(function()

                    root.Anchored = SavedData.Anchored

                    humanoid.PlatformStand = SavedData.PlatformStand
                    humanoid.AutoRotate = SavedData.AutoRotate

                    humanoid.WalkSpeed = SavedData.WalkSpeed
                    humanoid.UseJumpPower = SavedData.UseJumpPower

                    if SavedData.UseJumpPower then
                        humanoid.JumpPower = SavedData.JumpPower
                    end

                    root.AssemblyLinearVelocity = SavedData.Velocity
                    root.AssemblyAngularVelocity = SavedData.AngularVelocity

                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

                    task.wait()

                    humanoid:ChangeState(SavedData.State)

                    camera.CameraType = SavedData.CameraType
                    camera.CameraSubject = SavedData.CameraSubject

                    if cameraPart then
                        cameraPart:Destroy()
                    end

                    table.clear(SavedData)

                end)

            end

        end

    end)()
}


if #dados == 0 then return end

local primeiroFrame = dados[1]
local destino = Vector3.new(primeiroFrame.h[1], primeiroFrame.h[2], primeiroFrame.h[3])

local function tocarAnimacaoAndar()
    if not animateScript then return nil end
    local walkAnim = animateScript:FindFirstChild("walk")
    if not walkAnim then return nil end
    local walkAnimObj = walkAnim:FindFirstChild("WalkAnim")
    if not walkAnimObj then return nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = walkAnimObj.AnimationId
    local track = animator:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Movement
    track.Looped = true
    track:Play(0.2)
    return track
end

local function moverAtePrimeiroFrame()
    if (rootPart.Position - destino).Magnitude < 2 then return end
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })
    local sucesso = pcall(function()
        path:ComputeAsync(rootPart.Position, destino)
    end)
    if not sucesso or path.Status ~= Enum.PathStatus.Success then return end
    local waypoints = path:GetWaypoints()
    for _, waypoint in ipairs(waypoints) do
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end
        humanoid:MoveTo(waypoint.Position)
        local chegou = false
        local conexaoTimeout
        local conexaoChegou
        conexaoChegou = humanoid.MoveToFinished:Connect(function()
            chegou = true
        end)
        conexaoTimeout = task.delay(5, function()
            if not chegou then
                humanoid:MoveTo(rootPart.Position)
            end
        end)
        while not chegou do
            if (rootPart.Position - waypoint.Position).Magnitude < 4 then
                break
            end
            RunService.Heartbeat:Wait()
        end
        conexaoChegou:Disconnect()
    end
    humanoid:MoveTo(rootPart.Position)
end

local function rotacionarSuavemente(anguloX, anguloY, anguloZ, duracao)
    local alvo = CFrame.fromEulerAnglesXYZ(math.rad(anguloX), math.rad(anguloY), math.rad(anguloZ))
    local inicioTempo = tick()
    local cframeInicial = rootPart.CFrame
    local orientInicial = cframeInicial:ToOrientation()
    local orientAlvo = alvo:ToOrientation()
    while tick() - inicioTempo < duracao do
        local alpha = (tick() - inicioTempo) / duracao
        local rx = orientInicial.X + (orientAlvo.X - orientInicial.X) * alpha
        local ry = orientInicial.Y + (orientAlvo.Y - orientInicial.Y) * alpha
        local rz = orientInicial.Z + (orientAlvo.Z - orientInicial.Z) * alpha
        rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.fromEulerAnglesXYZ(rx, ry, rz)
        RunService.Heartbeat:Wait()
    end
end

local walkTrackTemp = tocarAnimacaoAndar()
moverAtePrimeiroFrame()

if walkTrackTemp then
    walkTrackTemp:Stop(0.1)
    walkTrackTemp:Destroy()
end


local h1 = primeiroFrame.h
rootPart.CFrame = CFrame.new(Vector3.new(h1[1], h1[2], h1[3])) * CFrame.fromEulerAnglesXYZ(math.rad(h1[4]), math.rad(h1[5]), math.rad(h1[6]))

local tempoInicio = tick()
local ultimoAnimId = ""
local trackAtual = nil
local indice = 1

local conexao
conexao = RunService.RenderStepped:Connect(function()
    local decorrido = tick() - tempoInicio
    local frameAtual = nil
    for i = indice, #dados do
        if dados[i].t >= decorrido then
            frameAtual = dados[i]
            indice = i
            break
        end
    end
    if not frameAtual then
        conexao:Disconnect()
        if trackAtual then
            trackAtual:Stop(0.1)
            trackAtual:Destroy()
            trackAtual = nil
        end
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.AutoRotate = true
        return
    end
    local h = frameAtual.h
    local pos = Vector3.new(h[1], h[2], h[3])
    local rot = CFrame.fromEulerAnglesXYZ(math.rad(h[4]), math.rad(h[5]), math.rad(h[6]))
    rootPart.CFrame = CFrame.new(pos) * rot
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    if frameAtual.a and frameAtual.a ~= "" and frameAtual.a ~= ultimoAnimId then
        if trackAtual then
            trackAtual:Stop(0.1)
            trackAtual:Destroy()
            trackAtual = nil
        end
        ultimoAnimId = frameAtual.a
        local anim = Instance.new("Animation")
        anim.AnimationId = frameAtual.a
        local sucesso, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if sucesso and track then
            track.Priority = Enum.AnimationPriority.Action
            track:Play(0.1)
            trackAtual = track
        end
    end
end)

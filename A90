local function cancelThread(t)
    if t and coroutine.status(t) ~= "dead" then
        task.cancel(t)
    end
end

local function startDownloadRotation()
    downloadRotationActive = true
    if downloadRotationThread then task.cancel(downloadRotationThread) end
    downloadRotationThread = task.spawn(function()
        while downloadRotationActive and downloadBtn and downloadBtn.Parent do
            local t1 = TweenService:Create(downloadBtn, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {Rotation = -15})
            t1:Play()
            t1.Completed:Wait()
            if not downloadRotationActive then break end

            local t2 = TweenService:Create(downloadBtn, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {Rotation = 15})
            t2:Play()
            t2.Completed:Wait()
            if not downloadRotationActive then break end
        end
    end)
end

local function stopDownloadRotation()
    downloadRotationActive = false
    if downloadRotationThread then
        task.cancel(downloadRotationThread)
        downloadRotationThread = nil
    end
    if downloadBtn and downloadBtn.Parent then
        pcall(function() downloadBtn.Rotation = 0 end)
    end
end

local function startCameraShake(intensity, duration)
    if cameraShakeThread then cancelThread(cameraShakeThread) end
    cameraShakeActive = true

    cameraShakeThread = task.spawn(function()
        local startTime = os.clock()
        while cameraShakeActive and (os.clock() - startTime < duration) do
            local offset = Vector3.new(
                (math.random() - 0.5) * intensity,
                (math.random() - 0.5) * intensity,
                (math.random() - 0.5) * intensity
            )
            local rotOffset = CFrame.Angles(
                (math.random() - 0.5) * math.rad(intensity * 0.6),
                (math.random() - 0.5) * math.rad(intensity * 0.6),
                (math.random() - 0.5) * math.rad(intensity * 0.6)
            )
            camera.CFrame = camera.CFrame * CFrame.new(offset) * rotOffset
            RunService.RenderStepped:Wait()
        end
    end)
end

local function stopCameraShake()
    cameraShakeActive = false
    if cameraShakeThread then
        cancelThread(cameraShakeThread)
        cameraShakeThread = nil
    end
end


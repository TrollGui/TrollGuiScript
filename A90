local currentPatenteIndex = 1
local patenteLabelRef = nil

local function getCurrentPatente()
    local head = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
    if head then
        local patente = head:FindFirstChild("Patente")
        if patente then
            local textLabel = patente:FindFirstChild("TextLabel")
            if textLabel then
                return textLabel
            end
        end
    end
    return nil
end

local function updatePatenteDisplay()
    if patenteLabelRef then
        patenteLabelRef.Text = patentes[currentPatenteIndex]
    end
end

local function changePatente(direction)
    currentPatenteIndex = currentPatenteIndex + direction
    if currentPatenteIndex < 1 then
        currentPatenteIndex = 1
    elseif currentPatenteIndex > #patentes then
        currentPatenteIndex = #patentes
    end
    updatePatenteDisplay()
end

local function initializePatenteIndex()
    local label = getCurrentPatente()
    if label then
        local currentText = label.Text
        for i, patente in ipairs(patentes) do
            if currentText == patente then
                currentPatenteIndex = i
                break
            end
        end
    end
end

local function updateCanvasSize(scrollingFrame)
    local totalHeight = 10
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            totalHeight = totalHeight + child.Size.Y.Offset + 10
        end
    end
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 50)
end


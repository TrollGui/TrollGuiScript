        vignette.Name = "FinalVignette"
        vignette.Size = UDim2.fromScale(1, 1)
        vignette.BorderSizePixel = 0
        vignette.BackgroundColor3 = RED
        vignette.BackgroundTransparency = 0.15
        vignette.Visible = false
        vignette.ZIndex = 50
        vignette.Parent = gui

        local vg = Instance.new("UIGradient")
        vg.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(0.2, 0.4),
            NumberSequenceKeypoint.new(0.5, 0.9),
            NumberSequenceKeypoint.new(0.8, 0.4),
            NumberSequenceKeypoint.new(1, 0.15)
        })
        vg.Parent = vignette

        local staticPart, staticCarmine, staticBlack, staticConnection
        local staticActive, staticAttack = false, false

        local function createStaticPart()
            if staticPart then staticPart:Destroy() end
            local cam = workspace.CurrentCamera
            if not cam then return end

            staticPart = Instance.new("Part")
            staticPart.Name = "A90Static"
            staticPart.Anchored = true
            staticPart.CanCollide = false
            staticPart.CanTouch = false
            staticPart.CanQuery = false
            staticPart.CastShadow = false
            staticPart.Material = Enum.Material.SmoothPlastic
            staticPart.Transparency = 1
            staticPart.Size = Vector3.new(20, 20, 0.05)
            staticPart.Parent = workspace

            staticCarmine = Instance.new("Texture")
            staticCarmine.Name = "CarmineStatic"
            staticCarmine.Texture = STATIC_TEXTURE
            staticCarmine.Face = Enum.NormalId.Front
            staticCarmine.Color3 = CARMINE
            staticCarmine.Transparency = 0
            staticCarmine.StudsPerTileU = 0.35
            staticCarmine.StudsPerTileV = 0.35
            staticCarmine.Parent = staticPart

            staticBlack = Instance.new("Texture")
            staticBlack.Name = "BlackStatic"
            staticBlack.Texture = STATIC_TEXTURE
            staticBlack.Face = Enum.NormalId.Front
            staticBlack.Color3 = BLACK
            staticBlack.Transparency = 0.35
            staticBlack.StudsPerTileU = 0.35
            staticBlack.StudsPerTileV = 0.35
            staticBlack.Parent = staticPart

            staticActive = true
            staticAttack = false

            if staticConnection then staticConnection:Disconnect() end
            staticConnection = RunService.RenderStepped:Connect(function()
                if not staticActive or not staticPart or not staticPart.Parent then return end
                cam = workspace.CurrentCamera
                if not cam then return end

                local distance = 0.7
                local viewport = cam.ViewportSize
                local aspect = viewport.X / math.max(viewport.Y, 1)
                local vs = 2 * distance * math.tan(math.rad(cam.FieldOfView * 0.5))
                local hs = vs * aspect

                staticPart.Size = Vector3.new(hs, vs, 0.05)
                local cp = cam.CFrame.Position
                local tp = cp + cam.CFrame.LookVector * distance
                staticPart.CFrame = CFrame.lookAt(tp, cp)

                staticCarmine.OffsetStudsU = math.random() * 2
                staticCarmine.OffsetStudsV = math.random() * 2
                staticBlack.OffsetStudsU = math.random() * 2
                staticBlack.OffsetStudsV = math.random() * 2

                if staticAttack then
                    staticCarmine.Color3 = RED
                    staticBlack.Color3 = RED
                    staticCarmine.Transparency = math.random(0, 10) / 100
                    staticBlack.Transparency = math.random(10, 50) / 100
                else
                    staticCarmine.Color3 = CARMINE
                    staticBlack.Color3 = BLACK
                    staticCarmine.Transparency = 0
                    staticBlack.Transparency = 0.35
                end
            end)
        end

        local function destroyStatic()
            staticActive = false
            if staticConnection then staticConnection:Disconnect() staticConnection = nil end
            if staticPart then staticPart:Destroy() staticPart = nil end
            staticCarmine = nil
            staticBlack = nil
        end

        local function playerIsMoving()
            local ch = Player3.Character
            if not ch then return false end
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h and h.MoveDirection.Magnitude > 0.05 then return true end
            return false
        end

        local function damagePlayer()
            local ch = Player3.Character
            local h = ch and ch:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h:TakeDamage(DAMAGE) end) end
        end

        local function attack()
            staticAttack = true
            if staticCarmine then staticCarmine.Color3 = RED end
            if staticBlack then staticBlack.Color3 = RED end

            playSound(SOUND_ATTACK, 1.5, false)
            face.Image = IMG_GLITCH
            face.ImageColor3 = WHITE
            task.wait(0.4)
            face.Visible = false
            task.wait(0.2)
            jumpscare.Visible = true

            local t0 = os.clock()
            while os.clock() - t0 < 1 do
                jumpscare.Position = UDim2.fromScale(
                    0.5 + math.random(-12, 12) / 1000,
                    0.5 + math.random(-12, 12) / 1000
                )
                jumpscare.Rotation = math.random(-3, 3)
                task.wait(0.025)
            end

            jumpscare.Position = UDim2.fromScale(0.5, 0.5)
            jumpscare.Rotation = 0
            jumpscare.Visible = false
            destroyStatic()

            background.Visible = true
            background.BackgroundColor3 = WHITE
            task.wait(0.2)
            background.BackgroundColor3 = RED
            task.wait(0.2)

            local f = TweenService:Create(background, TweenInfo.new(0.7, Enum.EasingStyle.Linear), {BackgroundTransparency = 1})
            f:Play()
            f.Completed:Wait()
            background.Visible = false

            playSound(SOUND_DEATH, 1.5, false)
            damagePlayer()

            vignette.Visible = true
            local vf = TweenService:Create(vignette, TweenInfo.new(15, Enum.EasingStyle.Linear), {BackgroundTransparency = 1})
            vf:Play()
            vf.Completed:Wait()
            vignette.Visible = false
        end

        local function getCurrentTool()
            local ch = Player3.Character
            if not ch then return nil end
            return ch:FindFirstChildOfClass("Tool")
        end

        local function toolChanged(initialTool)
            local currentTool = getCurrentTool()
            if initialTool == nil and currentTool ~= nil then return true end
            if initialTool ~= nil and currentTool == nil then return true end
            if initialTool ~= nil and currentTool ~= nil and initialTool ~= currentTool then return true end
            return false
        end

        local function runA90()
            gui.Enabled = true
            face.Visible = false
            jumpscare.Visible = false
            background.Visible = false
            vignette.Visible = false
            face.ImageTransparency = 0
            createStaticPart()

            playSound(SOUND_APPEAR, 10, false)
            if SOUND_APPEAR_LEAD_TIME > 0 then task.wait(SOUND_APPEAR_LEAD_TIME) end

            face.Image = IMG_NORMAL
            face.ImageColor3 = WHITE
            face.Size = UDim2.fromOffset(240, 240)
            face.Position = UDim2.fromScale(math.random(15, 85) / 100, math.random(15, 85) / 100)
            face.Visible = true
            task.wait(0.35)
            face.Position = UDim2.fromScale(0.5, 0.5)

            local ch = Player3.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local sp = root and root.Position

            local moved = false
            local ds = os.clock()

            local initialMousePos = UserInputService:GetMouseLocation()
            local initialTool = getCurrentTool()

            local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    local k = input.KeyCode
                    if k == Enum.KeyCode.W or k == Enum.KeyCode.A or k == Enum.KeyCode.S
                        or k == Enum.KeyCode.D or k == Enum.KeyCode.Space
                        or k == Enum.KeyCode.Up or k == Enum.KeyCode.Down
                        or k == Enum.KeyCode.Left or k == Enum.KeyCode.Right then
                        moved = true
                    end
                elseif input.UserInputType == Enum.UserInputType.Gamepad1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    moved = true
                end
            end)

            local mouseConnection = UserInputService.InputChanged:Connect(function(input, processed)
                if processed then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local currentPos = Vector2.new(input.Position.X, input.Position.Y)
                    if (currentPos - initialMousePos).Magnitude > 3 then
                        moved = true
                    end
                end
            end)

            local toolAddedConnection = nil
            local toolRemovedConnection = nil
            if ch then
                toolAddedConnection = ch.ChildAdded:Connect(function(child)
                    if child:IsA("Tool") then moved = true end
                end)
                toolRemovedConnection = ch.ChildRemoved:Connect(function(child)
                    if child:IsA("Tool") then moved = true end
                end)
            end

            while os.clock() - ds < 1.1 and not moved do
                if playerIsMoving() then moved = true break end
                ch = Player3.Character
                root = ch and ch:FindFirstChild("HumanoidRootPart")
                if root and sp then
                    if (root.Position - sp).Magnitude > 0.08 then moved = true break end
                end

                local currentMousePos = UserInputService:GetMouseLocation()
                if (currentMousePos - initialMousePos).Magnitude > 3 then moved = true break end

                if toolChanged(initialTool) then moved = true break end

                task.wait()
            end

            inputConnection:Disconnect()
            mouseConnection:Disconnect()
            if toolAddedConnection then toolAddedConnection:Disconnect() end
            if toolRemovedConnection then toolRemovedConnection:Disconnect() end

            if moved then
                if a90AttackEnabled then
                    attack()
                else
                    destroyStatic()
                    face.Visible = false
                    gui.Enabled = false
                end
                return
            end

            local ff = TweenService:Create(face, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {ImageTransparency = 1})
            ff:Play()
            ff.Completed:Wait()
            face.ImageTransparency = 0
            face.Visible = false
            destroyStatic()
        end

        task.spawn(function()
            task.wait(INITIAL_DELAY)
            while a90Active and not a90SpawnerStop do
                if uninstallMode and a90SpawnInterval then
                    pcall(runA90)
                    task.wait(a90SpawnInterval)
                elseif ENABLE_RESPAWN then
                    pcall(runA90)
                    task.wait(math.random(MIN_INTERVAL, MAX_INTERVAL))
                else
                    pcall(runA90)
                    break
                end
            end
        end)
    end)
end


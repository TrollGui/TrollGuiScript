local function makePromptsInstant()
    local BATCH_SIZE = 50

    local allDescendants = workspace:GetDescendants()
    local count = 0
    
    for _, desc in ipairs(allDescendants) do
        if not activeStatus then break end
        
        if desc:IsA("ProximityPrompt") then
            if originalHoldDurations[desc] == nil then
                originalHoldDurations[desc] = desc.HoldDuration
            end
            desc.HoldDuration = 0
            
            count = count + 1
            if count >= BATCH_SIZE then
                count = 0
                task.wait()
            end
        end
    end

    local connection
    connection = workspace.DescendantAdded:Connect(function(desc)
        if not activeStatus then
            connection:Disconnect()
            return
        end
        if desc:IsA("ProximityPrompt") then
            if originalHoldDurations[desc] == nil then
                originalHoldDurations[desc] = desc.HoldDuration
            end
            desc.HoldDuration = 0
        end
    end)
end

local function restorePrompts()
    for prompt, duration in pairs(originalHoldDurations) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = duration
        end
    end
    originalHoldDurations = {}
end

local function runFarmLogic()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local backpack = player.Backpack

    local lixosFolder = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Recolher Lixo"):WaitForChild("Lixos")
    local lixeirasFolder = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Recolher Lixo"):WaitForChild("Lixeiras")
    local promptPart = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Caixas"):WaitForChild("PromptPart")
    local areaEntrega = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Caixas"):WaitForChild("LocalEntrega"):WaitForChild("AreaEntrega")
    local foice = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Cortar Grama"):WaitForChild("Foice")
    local gramasFolder = workspace:WaitForChild("Map"):WaitForChild("Sistemas"):WaitForChild("Jobs"):WaitForChild("Cortar Grama"):WaitForChild("Gramas")

    local lixosUsados = {}
    local foiceUsada = false
    local gramasUsadas = {}

    local function waitOrStop(seconds)
        local elapsed = 0
        while elapsed < seconds do
            if not activeStatus then
                coroutine.yield()
            end
            task.wait(0.1)
            elapsed = elapsed + 0.1
        end
    end

    local function getObjects(folder)
        local objects = {}
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("Tool") or obj:IsA("Part") or obj:IsA("UnionOperation") then
                table.insert(objects, obj)
            end
        end
        return objects
    end

    local function getPrimaryPart(obj)
        if obj:IsA("BasePart") then
            return obj
        elseif obj:IsA("Model") then
            return obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
        else
            return obj:FindFirstChildWhichIsA("BasePart")
        end
    end

    local function findProximityPrompt(obj)
        local prompt = obj:FindFirstChild("ProximityPrompt")
        if prompt then return prompt end
        
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("ProximityPrompt") then
                return child
            end
        end
        
        if obj:IsA("Model") then
            local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                prompt = primaryPart:FindFirstChild("ProximityPrompt")
                if prompt then return prompt end
                
                for _, child in ipairs(primaryPart:GetDescendants()) do
                    if child:IsA("ProximityPrompt") then
                        return child
                    end
                end
            end
        end
        
        return nil
    end

    local function teleportTo(target)
        if not target then return false end
        character = player.Character or player.CharacterAdded:Wait()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end
        
        local targetPosition
        local targetPart = getPrimaryPart(target)
        
        if targetPart then
            targetPosition = targetPart.Position + Vector3.new(0, 2, 0)
        elseif target:IsA("Model") then
            local primary = target.PrimaryPart
            if primary then
                targetPosition = primary.Position + Vector3.new(0, 2, 0)
            else
                local anyPart = target:FindFirstChildWhichIsA("BasePart")
                if anyPart then
                    targetPosition = anyPart.Position + Vector3.new(0, 2, 0)
                else
                    return false
                end
            end
        else
            return false
        end
        
        rootPart.CFrame = CFrame.new(targetPosition)
        return true
    end

    local function interactWithPrompt(target)
        if not target then return false end
        local prompt = findProximityPrompt(target)
        if prompt and prompt:IsA("ProximityPrompt") then
            if prompt.Enabled then
                prompt:InputHoldBegin()
                waitOrStop(0.05)
                prompt:InputHoldEnd()
                return true
            end
        end
        return false
    end

    local function isValidTarget(obj)
        if not obj then return false end
        if obj:IsA("BasePart") then
            return true
        elseif obj:IsA("Model") then
            if obj.PrimaryPart then return true end
            if obj:FindFirstChildWhichIsA("BasePart") then return true end
            if obj:FindFirstChild("HumanoidRootPart") then return true end
        else
            if obj:FindFirstChildWhichIsA("BasePart") then
                return true
            end
        end
        return false
    end

    local function equipFoice()
        character = player.Character or player.CharacterAdded:Wait()
        backpack = player.Backpack
        local foiceTool = backpack:FindFirstChild("Foice")
        
        if not foiceTool then
            foiceTool = workspace:FindFirstChild("Foice")
            if foiceTool then
                foiceTool.Parent = backpack
            else
                return false
            end
        end
        
        if character:FindFirstChild("Foice") then
            return true
        end
        
        foiceTool.Parent = character
        waitOrStop(0.5)
        
        return character:FindFirstChild("Foice") ~= nil
    end

    local function unequipFoice()
        character = player.Character or player.CharacterAdded:Wait()
        backpack = player.Backpack
        local foiceTool = character:FindFirstChild("Foice")
        
        if foiceTool then
            foiceTool.Parent = backpack
            waitOrStop(0.3)
            return true
        end
        return false
    end

    local function escolherProximoLixo(validLixos)
        if #validLixos == 0 then return nil end
        if #lixosUsados >= #validLixos then
            lixosUsados = {}
        end
        
        local lixosDisponiveis = {}
        for _, lixo in ipairs(validLixos) do
            local jaUsado = false
            for _, usado in ipairs(lixosUsados) do
                if usado == lixo then
                    jaUsado = true
                    break
                end
            end
            if not jaUsado then
                table.insert(lixosDisponiveis, lixo)
            end
        end
        
        if #lixosDisponiveis == 0 then
            lixosUsados = {}
            lixosDisponiveis = validLixos
        end
        
        local lixoEscolhido = lixosDisponiveis[math.random(1, #lixosDisponiveis)]
        table.insert(lixosUsados, lixoEscolhido)
        return lixoEscolhido
    end

    local function escolherProximaGrama(validGramas)
        if #validGramas == 0 then return nil end
        if #gramasUsadas >= #validGramas then
            gramasUsadas = {}
        end
        
        local gramasDisponiveis = {}
        for _, grama in ipairs(validGramas) do
            local jaUsado = false
            for _, usado in ipairs(gramasUsadas) do
                if usado == grama then
                    jaUsado = true
                    break
                end
            end
            if not jaUsado then
                table.insert(gramasDisponiveis, grama)
            end
        end
        
        if #gramasDisponiveis == 0 then
            gramasUsadas = {}
            gramasDisponiveis = validGramas
        end
        
        local gramaEscolhida = gramasDisponiveis[math.random(1, #gramasDisponiveis)]
        table.insert(gramasUsadas, gramaEscolhida)
        return gramaEscolhida
    end

    while activeStatus do
        waitOrStop(0.5)
        
        local lixos = getObjects(lixosFolder)
        local lixeiras = getObjects(lixeirasFolder)
        
        local validLixos = {}
        for _, lixo in ipairs(lixos) do
            if isValidTarget(lixo) then table.insert(validLixos, lixo) end
        end
        
        local validLixeiras = {}
        for _, lixeira in ipairs(lixeiras) do
            if isValidTarget(lixeira) then table.insert(validLixeiras, lixeira) end
        end
        
        if #validLixos > 0 and #validLixeiras > 0 then
            local randomLixo = escolherProximoLixo(validLixos)
            if randomLixo then
                updateStatus("Coletando Lixo")
                if teleportTo(randomLixo) then
                    waitOrStop(0.5)
                    interactWithPrompt(randomLixo)
                    waitOrStop(1)
                    
                    local randomLixeira = validLixeiras[math.random(1, #validLixeiras)]
                    updateStatus("Colocando na Lixeira")
                    if teleportTo(randomLixeira) then
                        waitOrStop(0.5)
                        interactWithPrompt(randomLixeira)
                        waitOrStop(0.5)
                        
                        updateStatus("Pegando Caixa")
                        if teleportTo(promptPart) then
                            waitOrStop(0.5)
                            interactWithPrompt(promptPart)
                            waitOrStop(1)
                            
                            updateStatus("Colocando Caixa")
                            if teleportTo(areaEntrega) then
                                waitOrStop(1)
                            end
                        end
                    end
                    waitOrStop(0.5)
                end
            end
        end
        
        if not foiceUsada then
            updateStatus("Pegando Foice")
            if teleportTo(foice) then
                waitOrStop(0.5)
                if interactWithPrompt(foice) then
                    waitOrStop(1)
                    foiceUsada = true
                else
                    waitOrStop(1)
                end
            end
        end
        
        if equipFoice() then
            local gramas = getObjects(gramasFolder)
            local validGramas = {}
            for _, grama in ipairs(gramas) do
                if isValidTarget(grama) then table.insert(validGramas, grama) end
            end
            
            if #validGramas > 0 then
                local randomGrama = escolherProximaGrama(validGramas)
                if randomGrama then
                    updateStatus("Cortando Gramado")
                    if teleportTo(randomGrama) then
                        waitOrStop(0.5)
                        interactWithPrompt(randomGrama)
                        waitOrStop(1)
                    end
                end
            end
            unequipFoice()
        end
        
        waitOrStop(0.5)
    end
end


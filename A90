local function checkHeartInput(key)
    if not heartGameActive then return end

    local expectedSide = (key == Enum.KeyCode.E) and "right" or "left"

    local closestHeart = nil
    local closestDist = math.huge

    for _, h in ipairs(activeHearts) do
        if not h.resolved and h.frame and h.frame.Parent then
            if h.side == expectedSide then
                local pos = h.frame.Position.X.Scale
                local dist = math.abs(pos - 0.5)
                if dist < closestDist then
                    closestDist = dist
                    closestHeart = h
                end
            end
        end
    end

    if closestHeart and closestDist < 0.18 then
        closestHeart.resolved = true
        local heartText = closestHeart.frame:FindFirstChild("HeartText")
        if heartText then heartText.TextColor3 = GREEN end
        playSound(SOUND_HEART_CORRECT, 1.5, false)
        healHP(5)

        local f = closestHeart.frame
        task.spawn(function()
            local origPos = f.Position
            local startT = os.clock()
            while os.clock() - startT < 0.35 and f and f.Parent do
                local dx = math.random(-10, 10)
                local dy = math.random(-10, 10)
                f.Position = UDim2.new(origPos.X.Scale, dx, origPos.Y.Scale, dy)
                RunService.RenderStepped:Wait()
            end
            if f and f.Parent then
                f.Position = origPos
                for _, lbl in ipairs(f:GetDescendants()) do
                    if lbl:IsA("TextLabel") then
                        local ct = TweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1})
                        ct:Play()
                    end
                end
                task.wait(0.35)
                if f and f.Parent then f:Destroy() end
            end
        end)

        for i, h in ipairs(activeHearts) do
            if h == closestHeart then
                table.remove(activeHearts, i)
                break
            end
        end
    else
        damageHP(10)
        playSound(SOUND_HEART_WRONG, 1.2, false)
    end
end


local function startHeartGame()
    heartGameActive = true
    heartContainer.Visible = true

    for _, h in ipairs(activeHearts) do
        if h.frame and h.frame.Parent then
            h.frame:Destroy()
        end
    end
    activeHearts = {}
    startGridPulse()

    local startTime = os.clock()
    local duration = 30

    if heartGameThread then
        task.cancel(heartGameThread)
    end

    heartGameThread = task.spawn(function()
        while heartGameActive and (os.clock() - startTime) < duration do

            local availableSides = {}
            if hasHeartOnSide("left") < MAX_HEARTS_PER_SIDE then
                table.insert(availableSides, "left")
            end
            if hasHeartOnSide("right") < MAX_HEARTS_PER_SIDE then
                table.insert(availableSides, "right")
            end

            if #availableSides > 0 then
                local spawnCount = math.random(1, 2)

                for i = 1, spawnCount do

                    availableSides = {}
                    if hasHeartOnSide("left") < MAX_HEARTS_PER_SIDE then
                        table.insert(availableSides, "left")
                    end
                    if hasHeartOnSide("right") < MAX_HEARTS_PER_SIDE then
                        table.insert(availableSides, "right")
                    end

                    if #availableSides > 0 then
                        local side = availableSides[math.random(1, #availableSides)]
                        spawnHeart(side)
                    else
                        break
                    end
                end
            end

            task.wait(math.random(4, 8) / 10)
        end

        heartGameActive = false
        heartContainer.Visible = false
        stopGridPulse()

        for _, h in ipairs(activeHearts) do
            if h.frame and h.frame.Parent then
                h.frame:Destroy()
            end
        end
        activeHearts = {}
    end)
end


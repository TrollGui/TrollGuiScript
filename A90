local toggle6Frame, setToggle6State = createToggleButton(
    "Aimbot 🎯",
    function(state)
    local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local MAX_DISTANCE = 500
local AIM_SMOOTHNESS = 0.35

_G.__autoFireAimbotStop = _G.__autoFireAimbotStop or function() end
        _G.__autoFireAimbotStop()

        if not state then
            return
        end

        local Camera = workspace.CurrentCamera
        if not Camera then
            return
        end

        local running = true
        local connections = {}
        local lockedTarget = nil
        local lockedPart = nil

        local function disconnectAll()
            running = false

            for _, connection in ipairs(connections) do
                pcall(function()
                    connection:Disconnect()
                end)
            end

            table.clear(connections)

            lockedTarget = nil
            lockedPart = nil

            pcall(function()
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end)
        end

        _G.__autoFireAimbotStop = disconnectAll

        local function isGun(tool)
            if not tool or not tool:IsA("Tool") then
                return false
            end

            local ok, result = pcall(function()
                return tool:HasTag("Gun")
            end)

            return ok and result
        end

        local function getEquippedGun()
            local char = LocalPlayer.Character
            if not char then
                return nil
            end

            for _, object in ipairs(char:GetChildren()) do
                if isGun(object) then
                    return object
                end
            end

            return nil
        end

        local function getTargetPart(character)
            local head = character:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                return head
            end

            local root = character:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") then
                return root
            end

            for _, object in ipairs(character:GetChildren()) do
                if object:IsA("BasePart") then
                    return object
                end
            end

            return nil
        end

        local function isValidTarget(player)
            if player == LocalPlayer then
                return false
            end

            local character = player.Character
            if not character then
                return false
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")

            if not humanoid or humanoid.Health <= 0 or not root then
                return false
            end

            local sameTeam = false
            if LocalPlayer.Team and player.Team then
                sameTeam = LocalPlayer.Team == player.Team
            end

            local forceField = character:FindFirstChildOfClass("ForceField")

            return not sameTeam and not forceField
        end

        local function getClosestTarget()
            local cameraPosition = Camera.CFrame.Position

            local closestPlayer = nil
            local closestPart = nil
            local closestDistance = math.huge

            for _, player in ipairs(Players:GetPlayers()) do
                if isValidTarget(player) then
                    local character = player.Character
                    local root = character:FindFirstChild("HumanoidRootPart")

                    if root then
                        local part = getTargetPart(character)

                        if part then
                            local distance = (root.Position - cameraPosition).Magnitude

                            if distance < closestDistance and distance <= MAX_DISTANCE then
                                closestDistance = distance
                                closestPlayer = player
                                closestPart = part
                            end
                        end
                    end
                end
            end

            return closestPlayer, closestPart, closestDistance
        end


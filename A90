local activeSounds = {}

local function playSound(id, volume, looped, parent)
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = volume or 1
    s.Looped = looped or false
    s.Parent = parent or SoundService

    s:Play()
    local conn
    conn = s.Loaded:Connect(function()
        s:Play()
        if conn then conn:Disconnect() end
    end)

    task.delay(0.1, function()
        if s and s.Parent and not s.IsPlaying then
            s:Play()
        end
    end)

    table.insert(activeSounds, s)
    task.delay(120, function()
        for i, v in ipairs(activeSounds) do
            if v == s then table.remove(activeSounds, i) break end
        end
        if s and s.Parent then s:Destroy() end
    end)

    return s
end

local function stopSound(s)
    if s then
        pcall(function() s:Stop() end)
        pcall(function() s:Destroy() end)
    end
end

local pulseThreads = {}

local function startPulse(guiObj, baseScale, speed)
    baseScale = baseScale or 1.05
    speed = speed or 1.5

    if pulseThreads[guiObj] then
        task.cancel(pulseThreads[guiObj])
        pulseThreads[guiObj] = nil
    end

    local baseSize = guiObj.Size
    local thread = task.spawn(function()
        while guiObj and guiObj.Parent and guiObj.Visible do
            local t = TweenService:Create(guiObj, TweenInfo.new(speed / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset * baseScale, baseSize.Y.Scale, baseSize.Y.Offset * baseScale),
            })
            t:Play()
            t.Completed:Wait()
            if not (guiObj and guiObj.Parent and guiObj.Visible) then break end

            local t2 = TweenService:Create(guiObj, TweenInfo.new(speed / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = baseSize,
            })
            t2:Play()
            t2.Completed:Wait()
        end
    end)

    pulseThreads[guiObj] = thread
    return thread
end

local function stopPulse(guiObj)
    if pulseThreads[guiObj] then
        task.cancel(pulseThreads[guiObj])
        pulseThreads[guiObj] = nil
    end
end

local function animateButtonAppear(btn, baseSize)
    task.spawn(function()
        local function tw(size, time, style)
            local t = TweenService:Create(btn, TweenInfo.new(time, style or Enum.EasingStyle.Quad), {Size = size})
            t:Play()
            t.Completed:Wait()
        end
        tw(UDim2.new(0, baseSize.X.Offset * 1.3, 0, baseSize.Y.Offset * 1.3), 0.15)
        tw(UDim2.new(0, baseSize.X.Offset * 0.7, 0, baseSize.Y.Offset * 0.7), 0.15)
        tw(baseSize, 0.18, Enum.EasingStyle.Back)

        startPulse(btn, 1.08, 1.4)
    end)
end

local function animateButtonDisappear(btn, baseSize)
    stopPulse(btn)
    task.spawn(function()
        local function tw(size, time, style)
            local t = TweenService:Create(btn, TweenInfo.new(time, style or Enum.EasingStyle.Quad), {Size = size})
            t:Play()
            t.Completed:Wait()
        end
        tw(UDim2.new(0, baseSize.X.Offset * 1.3, 0, baseSize.Y.Offset * 1.3), 0.12)
        tw(UDim2.new(0, baseSize.X.Offset * 0.5, 0, baseSize.Y.Offset * 0.5), 0.12)
        tw(UDim2.new(0, 0, 0, 0), 0.18)
        btn.Visible = false
    end)
end


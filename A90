    local toggle1Frame, setToggle1State = createToggleButton(
        "🏋️ Fazer JJs",
        function(state)
            toggle1Active = state
            if state then
                local executionTime = 0.8

                local function processChatCommand(msg)
                    if string.sub(msg, 1, 1) == ";" then
                        local numberStr = string.gsub(string.sub(msg, 2), ",", ".")
                        local num = tonumber(numberStr)
                        if num and num > 0 then
                            executionTime = num
                            return true
                        end
                    end
                    return false
                end

                local chatConnection
                chatConnection = LocalPlayer.Chatted:Connect(processChatCommand)

                toggle1Loop = coroutine.create(function()
                    while toggle1Active do
                        local success = pcall(function()
                            local Polichinelos = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Polichinelos")
                            LocalPlayer:SetAttribute("Polichinelos", true)
                            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                            local humanoid = character:WaitForChild("Humanoid")
                            local animator = humanoid:WaitForChild("Animator")
                            local anim = animator:LoadAnimation(LocalPlayer.PlayerScripts:WaitForChild("Animations"):WaitForChild("Polichinelos"))
                            anim:Play()
                            task.wait(0.1)
                            Polichinelos:FireServer("Add", 1)
                        end)
                        task.wait(executionTime)
                    end
                end)
                coroutine.resume(toggle1Loop)
            else
                toggle1Active = false
            end
        end,
        "Execute exercícios automaticamente"
    )


local function clearESP()
    for obj, hl in pairs(objectHighlights) do
        if hl then
            pcall(function()
                hl:Destroy()
            end)
        end
    end

    table.clear(objectHighlights)

    updateCounter()
end

local function addHighlight(part)
    if not part then return end
    if objectHighlights[part] then return end

    if not part:IsA("BasePart") then
        return
    end

    local currentCount = 0

    for _ in pairs(objectHighlights) do
        currentCount += 1
    end

    if currentCount >= MAX_HIGHLIGHTS then
        return
    end

    local hl = Instance.new("Highlight")
    hl.Adornee = part
    hl.FillColor = Color3.fromRGB(0,255,0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(0,255,0)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = Workspace

    objectHighlights[part] = hl
end

local function processObject(obj)
    if obj:IsA("BasePart") then
        addHighlight(obj)

    elseif obj:IsA("Model") then
        local primary = obj.PrimaryPart

        if primary then
            addHighlight(primary)
        else
            local firstPart = obj:FindFirstChildWhichIsA("BasePart", true)

            if firstPart then
                addHighlight(firstPart)
            end
        end
    end
end

local function startSearch(searchText)
    currentSearchId += 1
    local searchId = currentSearchId

    clearESP()

    searchText = string.lower(searchText)

    if searchText == "" then
        return
    end

    local descendants = Workspace:GetDescendants()

    task.spawn(function()

        for i, obj in ipairs(descendants) do

            if searchId ~= currentSearchId then
                return
            end

            if obj and obj.Parent then

                local nameLower = string.lower(obj.Name)

                if string.find(nameLower, searchText, 1, true) then
                    processObject(obj)
                end
            end

            if i % 100 == 0 then
                task.wait()
            end
        end

        updateCounter()
    end)

    if scannerConnection then
        scannerConnection:Disconnect()
    end

    scannerConnection = Workspace.DescendantAdded:Connect(function(obj)

        if currentSearchId ~= searchId then
            return
        end

        if not obj then return end

        local nameLower = string.lower(obj.Name)

        if string.find(nameLower, searchText, 1, true) then
            processObject(obj)
            updateCounter()
        end
    end)
end

local function stopScanner()
    currentSearchId += 1

    if scannerConnection then
        scannerConnection:Disconnect()
        scannerConnection = nil
    end

    clearESP()
end


local function loadDictionary()
    allWords = {}
    usedWords = {}
    
    local urls = {}
    local currentCommonWords = commonWords
    
    if isPortuguese then
        urls = {
            "https://raw.githubusercontent.com/pythonprobr/palavras/master/palavras.txt"
        }
        currentCommonWords = commonWordsPT
    else
        urls = {
            "https://raw.githubusercontent.com/dwyl/english-words/refs/heads/master/words_dictionary.json",
            "https://raw.githubusercontent.com/first20hours/google-10000-english/master/google-10000-english-usa-no-swears.txt"
        }
        currentCommonWords = commonWords
    end

    for _, url in ipairs(urls) do
        local ok, content = pcall(function()
            return game:HttpGet(url)
        end)

        if ok and content then
            if content:match("^%s*{") then
                local success, wordsJson = pcall(function()
                    return HttpService:JSONDecode(content)
                end)
                
                if success and wordsJson then
                    for word, _ in pairs(wordsJson) do
                        if word and type(word) == "string" then
                            local cleanWord = word:lower():gsub("[^a-záàâãéèêíïóôõöúçñ]", "")
                            local len = #cleanWord
                            if len >= CONFIG.minLength and len <= CONFIG.maxLength and not currentCommonWords[cleanWord] then
                                table.insert(allWords, cleanWord)
                            end
                        end
                    end
                end
            else
                for word in content:gmatch("[^\r\n]+") do
                    if word and type(word) == "string" then
                        local cleanWord = word:lower():gsub("%s+", ""):gsub("[^a-záàâãéèêíïóôõöúçñ]", "")
                        local len = #cleanWord
                        if len >= CONFIG.minLength and len <= CONFIG.maxLength and not currentCommonWords[cleanWord] then
                            table.insert(allWords, cleanWord)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
    
    return #allWords > 0
end

local function autoTypeWord(word, currentInput)
    if isTyping then return end
    isTyping = true
    
    local remaining = word:sub(#currentInput + 1)
    local speed = insanoMode and CONFIG.typingSpeed or CONFIG.normalTypingSpeed
    
    task.spawn(function()
        local cam = workspace.CurrentCamera
        local size = cam.ViewportSize
        local x, y = size.X/2, size.Y/2
        
        for _ = 1, 2 do
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            task.wait(0.02)
        end

        for c in remaining:upper():gmatch(".") do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[c], false, game)
            task.wait(speed)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[c], false, game)
        end

        task.wait(0.08)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        
        isTyping = false
    end)
end

local function findLongestWord(input)
    local bestWord = nil
    local bestLength = 0
    
    for _, w in ipairs(allWords) do
        if w:sub(1, #input) == input and w ~= input and not usedWords[w] then
            if #w > bestLength then
                bestWord = w
                bestLength = #w
            end
        end
    end
    
    return bestWord
end

local function findCommonWord(input)
    local matchingWords = {}
    
    for _, w in ipairs(allWords) do
        if w:sub(1, #input) == input and w ~= input and not usedWords[w] then
            table.insert(matchingWords, w)
        end
    end
    
    if #matchingWords == 0 then
        return nil
    end
    
    table.sort(matchingWords, function(a, b)
        return #a < #b
    end)
    
    local shortWords = {}
    local minLength = #matchingWords[1]
    
    for _, w in ipairs(matchingWords) do
        if #w <= minLength + 2 then
            table.insert(shortWords, w)
        end
    end
    
    return shortWords[math.random(1, #shortWords)]
end

